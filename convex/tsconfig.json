{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "rootDir": "..",
    "outDir": "../dist/convex",
    "paths": {}
  },
  "include": [
    "./**/*.ts",
    "../engines/**/*.ts",
    "../ai/**/*.ts",
    "../lib/**/*.ts",
    "../types.ts"
  ],
  "exclude": ["node_modules", "_generated"]
}
