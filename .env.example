# Convex deployment URL — set automatically by `npx convex dev`
CONVEX_DEPLOYMENT=

# Google OAuth credentials (from Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend API key for magic-link emails (from resend.com)
AUTH_RESEND_KEY=

# The public URL of your deployed Convex backend
# Shown in the Convex dashboard after first deploy
CONVEX_SITE_URL=
